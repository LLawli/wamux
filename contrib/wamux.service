# systemd unit for running wamux natively (no container).
#
# Install:
#   cp contrib/wamux.service ~/.config/systemd/user/     # per-user
#   systemctl --user daemon-reload
#   systemctl --user enable --now wamux
#
# For a system-wide install put it in /etc/systemd/system/, add
# User=/Group=wamux, and change %h below to an absolute path.
#
# The DSN scheme picks the storage engine. sqlite:// needs no database server
# and is the right default for a single host; switch to postgres:// when
# running many accounts. See docs/DEPLOYMENT.md.

[Unit]
Description=wamux: WhatsApp multiplexer daemon (gRPC over a Unix socket)
Documentation=https://github.com/LLawli/wamux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=WAMUX_DATABASE_URL=sqlite://%S/wamux/wamux.db
Environment=WAMUX_SOCKET_PATH=%S/wamux/wamux.sock
Environment=WAMUX_LOG_LEVEL=info,wamux=info
# Encryption at rest for a NEW store (#164, docs/DEPLOYMENT.md): create the key
# with `openssl rand -hex 32`, mode 0600, then uncomment both lines. systemd
# hands the service a private copy under %d (the credentials directory).
#LoadCredential=store-key:/etc/wamux/store-key
#Environment=WAMUX_STORE_KEY_FILE=%d/store-key
ExecStart=%h/.local/bin/wamux
Restart=on-failure
RestartSec=10

# Creates and owns %S/wamux (~/.local/state/wamux for a user unit), which is
# where both the database and the socket live. 0700 because the database holds
# every account's identity keys (docs/DEPLOYMENT.md, "The store is a secret"):
# systemd would create it 0755, and UMask= does not apply to it. The consumer of
# this user unit is the same user, so the socket stays reachable; a system-wide
# install that serves another user moves the socket to a RuntimeDirectory=.
StateDirectory=wamux
StateDirectoryMode=0700

# The media spool (#79): SendMedia, PostStatusMedia and DownloadMedia stage each
# file on disk instead of in memory. CacheDirectory= creates %C/wamux
# (~/.cache/wamux for a user unit, /var/cache/wamux for a system one) and makes
# it writable under ProtectSystem=strict below. It is a real disk on purpose:
# /tmp and /run are RAM here, which would put the files back in memory.
CacheDirectory=wamux
Environment=WAMUX_MEDIA_SPOOL_DIR=%C/wamux

# The daemon opens one socket and talks to WhatsApp; it needs nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# The daemon now creates its store file 0600 on its own (#75); this umask is
# defense in depth for everything else it writes.
UMask=0077

[Install]
WantedBy=default.target
