# wamux configuration. Copy to wamux.toml (or set WAMUX_CONFIG to a path).
# Every key can be overridden by an env var: WAMUX_<UPPERCASE_KEY>.

# Unix socket the gRPC server binds.
socket_path = "/run/wamux.sock"
# Socket file mode: 432 == 0o660. TOML also accepts 0o660; env vars need decimal.
socket_mode = 432
# Group that owns the socket (#77): a name (looked up through NSS) or a number
# taken as a gid. The daemon's user must be a member, or startup fails; so does
# a group that does not exist. Unset keeps the daemon's own group.
# socket_group = "wamux"
# Optional allowlist by SO_PEERCRED (#77). A peer whose uid is in allowed_uids,
# or whose effective gid is in allowed_gids, is served; any other gets
# PermissionDenied. Both empty (the default) serve everyone who can open the
# socket. The gid is the peer's effective gid: supplementary groups are not
# visible.
# allowed_uids = [1000]
# allowed_gids = [1000]

# Database DSN. The scheme picks the storage engine:
#   postgres:// (or postgresql://)  the multi-account default
#   sqlite://   single file, no server; created if absent
#   turso://    EXPERIMENTAL single file through the native turso crate; needs a
#                 binary built with `--features turso` (see docs/DEPLOYMENT.md).
#                 A path only, no query string: turso://<path>
# e.g. database_url = "sqlite:///var/lib/wamux/wamux.db"
#      database_url = "turso:///var/lib/wamux/wamux.db"
database_url = "postgres://wamux:wamux@localhost:5432/wamux"
# Postgres pool size. Ignored under sqlite:// (one writer connection behind
# the group commit, plus a fixed pool of read-only ones) and under turso://
# (one connection behind a mutex).
db_max_connections = 16
# Path of the store key file (64 hex characters, mode 0600); set, it turns on
# encryption at rest. See "Encryption at rest" in docs/DEPLOYMENT.md.
# store_key_file = "/etc/wamux/store-key"

# Per-account in-memory replay ring (events kept for quick reconnect).
event_ring_capacity = 256

# Per-account live broadcast capacity. A subscriber slower than this lags past
# the buffer and gets a "gap" marker (resync via GetAccountStatus).
broadcast_capacity = 1024

# Largest event (encoded bytes) still kept in the replay ring; 0 = no cap.
# Bigger events are still delivered live, they just cannot be replayed.
# History-sync blobs are always excluded from the ring (they are bulk, not live).
# Default 262144 (256 KiB) (#80). Measured on 327 147 real envelopes: outside
# history sync the largest was 146 KiB and none went above 256 KiB, so nothing
# real drops out of the replay window. With a 256-event ring this bounds one
# account's ring at 64 MiB; without the cap one event could be megabytes.
replay_max_event_bytes = 262144

# Max accounts kept connected at once (fd/resource budget); 0 = unlimited.
# Connect past this returns ResourceExhausted. The edge owns connect policy.
max_connected_accounts = 200

# Grace period (ms) for a graceful per-account stop before a hard abort.
graceful_stop_timeout_ms = 3000

# After SIGTERM, how long (ms) the server may keep draining before the
# connections it still holds are closed. Event subscriptions end on their own
# at shutdown; this bounds anything else. Keep it under systemd's stop timeout.
shutdown_grace_ms = 10000

# Max bytes accepted for an inbound media send (inline streamed chunks), and the
# largest file DownloadMedia will fetch (#79).
media_max_bytes = 104857600

# Where media transfers are staged on disk (#79). Created 0700 at startup; the
# daemon refuses to start if it cannot be written. Files in it have no name, so
# it always looks empty. Use a real disk, never a tmpfs or /tmp (that is RAM).
media_spool_dir = "/var/cache/wamux"

# The most all transfers in flight may hold in the spool, summed (#79). Past it
# a transfer gets ResourceExhausted. Keep it below the free space of
# media_spool_dir. 0 = unlimited.
media_spool_max_bytes = 2147483648

# tracing env-filter (RUST_LOG overrides this when set).
log_level = "info,wamux=debug"

# Log output format: "json" (structured, for ingestion) or "text" (default).
log_format = "text"

# gRPC reflection, so grpcurl can list and describe the services. On by
# default; set false to turn it off.
enable_reflection = true

# Note: there is no DM-routing knob. The core relays to whatever recipient JID
# the client sends, verbatim.
